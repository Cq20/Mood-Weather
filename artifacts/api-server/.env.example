# ===== API Server 环境变量模板 =====
# 复制为 .env 并填写真实值。严禁将 .env 提交到版本库。

# 服务端口（默认 3000）
PORT=3000

# PostgreSQL 连接串（必填）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moodweather

# 允许的前端源（CORS 白名单，逗号分隔的显式域名，不支持通配符）
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# 部署在反向代理/负载均衡后时设为 true（限流依赖真实客户端 IP）
TRUST_PROXY=false

# production / development / test
NODE_ENV=development

# pino 日志级别：debug | info | warn | error
LOG_LEVEL=info
